# Authenticated personal Docker Compose profile. No secrets belong in this file.
# Keep SQLite on the local named volume, never SMB/NFS. Bootstrap interactively:
# docker compose exec app python -m app.cli bootstrap
DATA_DIR=/data
LOCAL_HTTP=1
REQUIRE_PASSWORD=1
ALLOW_HTTP_BOOTSTRAP=0
ALLOWED_HOSTS=127.0.0.1,localhost
# Optional HTTPS overlay only: a domain already pointing at your persistent host.
# SEORAP_PUBLIC_HOST=media.example.com
# Vercel's SEORAP_APP_ORIGIN belongs in Vercel project settings; see docs/VERCEL_DEPLOYMENT.md.
SESSION_COOKIE=seorap_session
SESSION_TTL_SECONDS=43200

# Production engine; fixture hooks must remain off outside isolated tests.
MEDIA_ADAPTER=ytdlp
ALLOW_FIXTURE_URLS=0
ALLOW_TEST_HOOKS=0
# FIXTURE_CATALOG=/fixtures/catalog.json  # isolated fixture profile only
ENABLE_PLAYLISTS=0
ENABLE_TRANSCODING=0
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
DENO_PATH=/opt/seorap/bin/deno
DENO_DIR=/tmp/deno-cache
XDG_CACHE_HOME=/tmp/cache

# Single-task worker and separately bounded metadata analysis.
MEDIA_CONCURRENCY=1
ANALYSIS_CONCURRENCY=1
MAX_WAITING_JOBS=20
ANALYSIS_TTL_SECONDS=600
ANALYSIS_DEADLINE_SECONDS=60
MAX_SOURCE_DURATION_SECONDS=14400
ACTIVE_JOB_DEADLINE_SECONDS=7200
MAX_AUTO_RETRIES=2
SSE_HEARTBEAT_SECONDS=5

# These are policy ceilings, not promises that a source offers the output.
NATIVE_MP4_CAP=2160
DEFAULT_MP4_CAP=1080
CONVERSION_CAP=1080
MP3_DEFAULT_KBPS=192

# Bytes: 5 GiB input/output, 12 GiB workspace, 50 GiB total, 2 GiB free.
MAX_INPUT_BYTES=5368709120
MAX_OUTPUT_BYTES=5368709120
MAX_WORKSPACE_BYTES=12884901888
MAX_STORAGE_BYTES=53687091200
MIN_FREE_BYTES=2147483648
FILE_TTL_SECONDS=86400
HISTORY_RETENTION_SECONDS=7776000
# Preview file logger: each current log plus two backups; Compose logs separately.
LOG_MAX_BYTES=5242880
